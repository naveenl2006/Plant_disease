# ── Copy this file to .env and adjust values ─────────────────────────────────

# Paths
DATA_DIR=./dataset_flat_structure
SAVE_DIR=./checkpoints
RESULTS_DIR=./results

# Model (b0 / b1 / b2 / b3 / b4)
MODEL_VERSION=b1

# Standard training
BATCH_SIZE=16
LEARNING_RATE=0.0003
WEIGHT_DECAY=0.0001
LABEL_SMOOTHING=0.1
DROPOUT_RATE=0.35

# Augmentation
MIXUP_ALPHA=0.3
CUTMIX_PROB=0.4

# DataLoader
NUM_WORKERS=4
PREFETCH_FACTOR=2
PERSISTENT_WORKERS=true

# TTA
TTA_N=5

# Seed
SEED=42

# ══ FedProx-specific ═══════════════════════════════════════════════════════
NUM_CLIENTS=3
NUM_ROUNDS=25
LOCAL_EPOCHS=5
MU=0.01
FRACTION_FIT=1.0
UNFREEZE_ROUND=8
UNFREEZE_LAST_N_BLOCKS=5
IID_PARTITION=true
DIRICHLET_ALPHA=0.5
